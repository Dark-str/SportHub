# Copy to .env. Never commit real credentials. Environment variables override this file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nsbm_sportshub
DB_USER=nsbm_sportshub
DB_PASSWORD=
APP_ENV=development
APP_URL=http://localhost:8000
# Generate a cryptographically random secret of at least 32 bytes before login.
JWT_SECRET=
JWT_TTL=3600
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
